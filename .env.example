# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# Atlas connection string, including the database name in the path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/strongwash?retryWrites=true&w=majority

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session cookie signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Cloudinary — storage for quote-request attachments.
# Dashboard → Settings → API Keys. Server-only: do NOT add a NEXT_PUBLIC_ prefix,
# or the secret ships to the browser. Without these, the quote form still works
# and the API answers 503 for any request carrying a file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth. Register BOTH redirect URIs in Google Cloud Console →
# Credentials → your OAuth client → Authorised redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-domain>/api/auth/google/callback
# Server-only: never prefix the secret with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email for password-reset links, over Gmail SMTP.
# Create the app password at myaccount.google.com/apppasswords (needs 2FA on).
# It bypasses 2FA for SMTP, so it is a full credential for that mailbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Strong Wash <you@gmail.com>

# Phase 3 — semantic search
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
